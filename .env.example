# Copia este archivo como ".env" y escribe tus datos reales.
# El archivo .env NO se sube a GitHub (esta en .gitignore).
# Los datos los encuentras en Clever Cloud > tu add-on MySQL > "Information"
DB_HOST=xxxxxxxx-mysql.services.clever-cloud.com
DB_PORT=3306
DB_USER=usuario_clever
DB_PASSWORD=contrasena_clever
DB_NAME=nombre_bd_clever
DB_CONN_LIMIT=4
PORT=3000
